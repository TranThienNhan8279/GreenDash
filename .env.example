# Sao chép thành .env (KHÔNG commit .env lên GitHub).
GREENDASH_DB=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost\SQLEXPRESS;DATABASE=GreenDashDB;Trusted_Connection=yes;TrustServerCertificate=yes;
GREENDASH_CHU_KY_GIAY=60
GREENDASH_URL=http://localhost:8000
# Khóa API in ra một lần khi chạy tools/khoi_tao.py. Đặt bằng biến môi trường GREENDASH_API_KEY, không ghi vào file.
