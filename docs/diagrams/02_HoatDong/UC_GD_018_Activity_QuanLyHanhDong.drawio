<mxfile host="app.diagrams.net"><diagram name="Activity - UC_GD_018 Quản lý hành động giảm tác động" id="d1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2336" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Kỹ sư DevOps / Nhà phát triển (AC02, AC03)" style="swimlane;html=1;startSize=30;fillColor=#f5f5f5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="260" height="1180" as="geometry"/></mxCell><mxCell id="c3" value="Hệ thống GreenDash" style="swimlane;html=1;startSize=30;fillColor=#f5f5f5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="20" width="520" height="1180" as="geometry"/></mxCell><mxCell id="c4" value="" style="ellipse;html=1;fillColor=#000000;" vertex="1" parent="1"><mxGeometry x="140.0" y="90.0" width="20" height="20" as="geometry"/></mxCell><mxCell id="c5" value="Mở danh sách hành động, chọn một dòng" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60.0" y="185.0" width="180" height="50" as="geometry"/></mxCell><mxCell id="c6" value="Hiển thị chi tiết và mức giảm ước tính" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320.0" y="295.0" width="180" height="50" as="geometry"/></mxCell><mxCell id="c7" value="Chọn Chấp nhận, Từ chối (kèm lý do) hoặc Đánh dấu đã áp dụng (nhập ngày)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60.0" y="397.5" width="180" height="65" as="geometry"/></mxCell><mxCell id="c8" value="Thao tác là Từ chối?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="335.0" y="500.0" width="150" height="80" as="geometry"/></mxCell><mxCell id="c9" value="Không có lý do thì từ chối thao tác (A1); có lý do thì đổi sang Từ chối, lưu lý do" style="rounded=