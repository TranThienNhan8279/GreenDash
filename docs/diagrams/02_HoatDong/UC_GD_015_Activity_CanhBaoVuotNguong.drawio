<mxfile host="app.diagrams.net"><diagram name="Activity - UC_GD_015 Cảnh báo vượt ngưỡng" id="d1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2336" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Bộ lập lịch (AC06)" style="swimlane;html=1;startSize=30;fillColor=#f5f5f5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="260" height="1070" as="geometry"/></mxCell><mxCell id="c3" value="Hệ thống GreenDash" style="swimlane;html=1;startSize=30;fillColor=#f5f5f5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="20" width="520" height="1070" as="geometry"/></mxCell><mxCell id="c4" value="" style="ellipse;html=1;fillColor=#000000;" vertex="1" parent="1"><mxGeometry x="140.0" y="90.0" width="20" height="20" as="geometry"/></mxCell><mxCell id="c5" value="Kích hoạt kiểm tra ngưỡng (sau UC_GD_011 hoặc theo lịch)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60.0" y="177.5" width="180" height="65" as="geometry"/></mxCell><mxCell id="c6" value="Lấy kết quả đã quy đổi chưa kiểm tra và các ngưỡng đang hiệu lực" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320.0" y="287.5" width="180" height="65" as="geometry"/></mxCell><mxCell id="c7" value="Kết quả vượt ngưỡng?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="335.0" y="390.0" width="150" height="80" as="geometry"/></mxCell><mxCell id="c8" value="Bỏ qua kết quả này, đánh dấu đã kiểm tra" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;" vertex="1" parent="1"><mxGeometry x="545.0" y="405.0" width="190" height="50" as="geometry"/></mxCell><mxCell id="c9" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="762.0" y="417.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="c10" value="Đã có cảnh báo chưa đóng cùng ngưỡng, cùng môi trường? (BR10)" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="335.0" y="500.0" width="150" height="80" as="geometry"/></mxCell><mxCell id="c11" value="Không tạo mới, chỉ cập nhật giá trị và thời điểm gần nhất (A1)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;" vertex="1" parent="1"><mxGeometry x="545.0" y="507.5" width="190" height="65" as="geometry"/></mxCell><mxCell id="c12" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="762.0" y="527.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="c13" value="Tạo cảnh báo trạng thái Mới, ghi giá trị vi phạm và nhãn Đo hoặc Ước lượng (A2)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320.0" y="610.0" width="180" height="80" as="geometry"/></mxCell><mxCell id="c14" value="Gửi thông báo (email hoặc trong ứng dụng) cho DevOps phụ trách" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320.0" y="727.5" width="180" height="65" as="geometry"/></mxCell><mxCell id="c15" value="Gửi thành công?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="335.0" y="830.0" width="150" height="80" as="geometry"/></mxCell><mxCell id="c16" value="Giữ cảnh báo, ghi log và thử gửi lại (E1)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;" vertex="1" parent="1"><mxGeometry x="545.0" y="845.0" width="190" height="50" as="geometry"/></mxCell><mxCell id="c17" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="762.0" y="857.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="c18" value="" style="ellipse;html=1;shape=endState;fillColor=#000000