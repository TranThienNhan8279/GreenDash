<mxfile host="app.diagrams.net"><diagram name="Activity - UC_GD_004 Quản lý người dùng và phân quyền" id="d1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2336" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Quản trị hệ thống (AC01)" style="swimlane;html=1;startSize=30;fillColor=#f5f5f5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="260" height="1290" as="geometry"/></mxCell><mxCell id="c3" value="Hệ thống GreenDash" style="swimlane;html=1;startSize=30;fillColor=#f5f5f5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="20" width="520" height="1290" as="geometry"/></mxCell><mxCell id="c4" value="" style="ellipse;html=1;fillColor=#000000;" vertex="1" parent="1"><mxGeometry x="140.0" y="90.0" width="20" height="20" as="geometry"/></mxCell><mxCell id="c5" value="Mở màn hình Người dùng, chọn thao tác" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60.0" y="185.0" width="180" height="50" as="geometry"/></mxCell><mxCell id="c6" value="Hiển thị danh sách và biểu mẫu" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320.0" y="295.0" width="180" height="50" as="geometry"/></mxCell><mxCell id="c7" value="Thêm hoặc Sửa: nhập thông tin, nhấn Lưu; hoặc chọn: Khóa / Mở khóa tài khoản" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60.0" y="390.0" width="180" height="80" as="geometry"/></mxCell><mxCell id="c8" value="Thao tác là: Khóa / Mở khóa tài khoản?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="335.0" y="500.0" width="150" height="80" as="geometry"/></mxCell><mxCell id="c9" value="Cập nhật trạng thái, ghi nhật ký; không cho tự khóa hoặc tự hạ quyền chính mình (A2)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;" vertex="1" parent="1"><mxGeometry x="545.0" y="500.0" width="190" height="80" as="geometry"/></mxCell><mxCell id="c10" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="762.0" y="527.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="c11" value="Đủ thông tin bắt buộc, email hợp lệ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="335.0" y="610.0" width="150" height="80" as="geometry"/></mxCell><mxCell id="c12" value="Từ chối, báo thông tin chưa hợp lệ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;" vertex="1" parent="1"><mxGeometry x="545.0" y="625.0" width="190" height="50" as="geometry"/></mxCell><mxCell id="c13" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="762.0" y="637.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="c14" value="Tên đăng nhập chưa tồn tại? (A1)" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="335.0" y="720.0" width="150" height="80" as="geometry"/></mxCell><mxCell id="c15" value="Báo: Tên đăng nhập đã tồn tại" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;" vertex="1" parent="1"><mxGeometry x="545.0" y="735.0" width="190" height="50" as="geometry"/></mxCell><mxCell id="c16" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="762.0" y="747.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="c17" value="Lưu tài khoản, vai trò, sản phẩm được truy cập; tạo mật khẩu tạm (băm); ghi nhật ký" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320.0" y="830.0" width="180" height="80" as="geometry"/></mxCell><mxCell id="c18" value="Lưu thành công?" style="rhombus;whiteSpace=wrap;html=1;fontS